        "textMode": "value"
      },
      "id": 6,
      "gridPos": {
        "x": 19,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "interval": "5m",
      "type": "timeseries",
      "title": "Questions by outcome",
      "description": "One label per question, counted from the one log line each question writes. Every degraded label here returned HTTP 200.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (outcome) (count_over_time({service_name=~\"$service\"} |= \"rag.request\" | json | tenant=~\"$tenant\" [$__interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Latency per question (p50, p95)",
