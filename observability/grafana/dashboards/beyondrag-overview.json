      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "(sum(count_over_time({service_name=~\"$service\"} |= \"rag.request\" | json | tenant=~\"$tenant\" | outcome_group=\"error\" [$__range])) or vector(0)) / sum(count_over_time({service_name=~\"$service\"} |= \"rag.request\" | json | tenant=~\"$tenant\" [$__range]))",
          "legendFormat": "",
          "refId": "A",
          "queryType": "instant"
