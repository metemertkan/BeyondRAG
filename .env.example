# BeyondRAG — Enterprise RBAC & Cross-Lingual RAG Sandbox Configuration

# Web Application Port
WEB_HOST=0.0.0.0
WEB_PORT=8090

# Elasticsearch 8.15 Sandbox Endpoint
ELASTICSEARCH_URL=http://localhost:9200

# Optional LLM Synthesis Configuration (Fast grounded mode works offline with zero API keys)
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
USE_LOCAL_ONLY=false

# Episode 2 — Embedding contract
# feature_hash (CI default) | ollama | remote_api | google | fake
RAG_EMBEDDING_PROVIDER=feature_hash
RAG_EMBEDDING_DIMS=256
RAG_EMBEDDING_MODEL=bge-m3
# OpenAI-compatible remote embeddings (when RAG_EMBEDDING_PROVIDER=remote_api)
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_API_BASE=https://api.openai.com/v1
# Optional alias also accepted by RemoteApiEmbeddingProvider:
# OPENAI_API_KEY=

# Episode 2 — Language packs (JSON). Codes/lists live in pack data, not orchestration.
# Defaults: config/language_packs.defaults.json (copied to workspace on first boot).
RAG_CORPUS_LANGUAGE=en
# RAG_LANGUAGE_PACKS_PATH=/app/workspace/language_packs.json

# Episode 2 — Dashboard demo chrome (html lang, placeholder, quick prompts)
# RAG_UI_DEMO_CONFIG=/app/config/ui_demo.json

# Episode 2 — PDF parser degraded fallback (pdfplumber → PyPDF)
# true: WARNING + reason, record parser_name/parser_degraded, continue INDEXED
# false: WARNING + reason, fail loud (ParserDegradedError)
RAG_PARSER_ALLOW_DEGRADED=true
