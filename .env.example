# BeyondRAG — Enterprise RBAC & Cross-Lingual RAG Sandbox Configuration

# Web Application Port
WEB_HOST=0.0.0.0
WEB_PORT=8090

# Elasticsearch 8.15 Sandbox Endpoint
ELASTICSEARCH_URL=http://localhost:9200

# Optional LLM Synthesis Configuration (Fast grounded mode works offline with zero API keys)
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# The Docker container does not read the line above (its localhost is the container).
# It reaches the host's Ollama at host.docker.internal; to change that, set:
# OLLAMA_DOCKER_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
USE_LOCAL_ONLY=false

# Episode 2 — Embedding contract
# feature_hash (CI default) | ollama | remote_api | google | fake
RAG_EMBEDDING_PROVIDER=feature_hash
RAG_EMBEDDING_DIMS=256
RAG_EMBEDDING_MODEL=bge-m3
# OpenAI-compatible remote embeddings (when RAG_EMBEDDING_PROVIDER=remote_api)
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_API_BASE=https://api.openai.com/v1
# Optional alias also accepted by RemoteApiEmbeddingProvider:
# OPENAI_API_KEY=

# Episode 2 — Language packs (JSON). Codes/lists live in pack data, not orchestration.
# Defaults: config/language_packs.defaults.json (copied to workspace on first boot).
RAG_CORPUS_LANGUAGE=en
# RAG_LANGUAGE_PACKS_PATH=/app/workspace/language_packs.json

# Episode 2 — Dashboard demo chrome (html lang, placeholder, quick prompts)
# RAG_UI_DEMO_CONFIG=/app/config/ui_demo.json

# Episode 2 — PDF parser degraded fallback (pdfplumber → PyPDF)
# true: WARNING + reason, record parser_name/parser_degraded, continue INDEXED
# false: WARNING + reason, fail loud (ParserDegradedError)
RAG_PARSER_ALLOW_DEGRADED=true

# Chunking: sliding_window | paragraph | sentence | recursive | semantic | adaptive
# adaptive routes long prose to semantic chunking and uniform content to fixed-size.
RAG_CHUNKING_STRATEGY=adaptive

# Excel: sheets over this many rows get a summary chunk plus a SQLite table.
RAG_XLSX_INLINE_ROWS=40
# true: add an LLM-written purpose sentence to each large-table summary at ingestion.
RAG_XLSX_LLM_SUMMARY=false

# Scanned PDF pages. Requires: pip install .[ocr]. PaddleOCR codes, e.g. ar,ch,en
RAG_OCR_LANGS=

# Enables POST /api/erasure and POST /api/sync/events. Both stay off while this is empty.
RAG_GOVERNANCE_TOKEN=
# Key for hashed identifiers in the audit log. Generated under workspace/ if empty.
RAG_ERASURE_KEY=

# Vector index: int8_hnsw (default) | int4_hnsw | hnsw. Applies when the index is created.
RAG_VECTOR_INDEX_TYPE=int8_hnsw
# Search small child chunks, then pass their large parent to the LLM.
RAG_PARENT_CHILD=true
RAG_PARENT_TOKENS=1000
RAG_CHILD_TOKENS=200
# LLM query transformation: off | multi | hyde | both
RAG_QUERY_MODE=off
# Cross-encoder re-ranking of the top candidates. The model downloads on first use.
RAG_RERANK=false
RAG_RERANK_CANDIDATES=20
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# Decompose questions into dependent searches. Adds LLM calls to every query.
RAG_MULTI_HOP=false
# Check LLM answers against their cited sources: annotate | strip | abstain
RAG_VERIFY=false
RAG_VERIFY_WITH_LLM=true
RAG_TRUST_MODE=annotate
# With re-ranking on, refuse below this best-candidate score. Empty means off.
RAG_MIN_RELEVANCE=

# Episode 5 — Tenants and identity
# demo: the dashboard mints its own tokens, the index is reset and sample tenants are loaded
#       at start. For a laptop. Anyone who can reach the port can become any tenant.
# required: every request needs a bearer token signed with RAG_AUTH_SECRET. Nothing is
#       reset or seeded at start, and POST /api/auth/demo-token returns 404.
RAG_AUTH_MODE=demo
# HS256 signing key, at least 32 bytes: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Empty in demo mode: a key is generated at workspace/.auth_secret. Empty in required mode: 503.
RAG_AUTH_SECRET=
# Roles allowed to upload, retag and delete inside their own tenant (comma-separated).
RAG_WRITE_ROLES=admin
# Browser origins allowed to call the API from another site (comma-separated). Empty: none.
RAG_CORS_ORIGINS=
# shared: one index, every query filtered by tenant (pool).
# per_tenant: one index per tenant, named {RAG_INDEX_PREFIX}-{tenant}, plus the same filter (silo).
RAG_TENANT_MODE=shared
RAG_INDEX_PREFIX=hk-rbac-rag-kb
# Tenant for data written before tenants existed, and for callers that pass none on a write.
RAG_DEFAULT_TENANT=default

# Episode 6 — Observability. Empty endpoint sends nothing.
# Start the local Grafana stack: docker compose --profile observability up -d lgtm
# Then: http://localhost:4318 for runs on the host, http://lgtm:4318 for the app container.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=beyondrag
# Milliseconds between metric exports. The OpenTelemetry default is 60000.
OTEL_METRIC_EXPORT_INTERVAL=15000
# true turns spans and metrics into no-ops.
OTEL_SDK_DISABLED=false
# true stores prompts and answers on spans, with personal data masked. Off by default.
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Seconds to wait for one model reply before the fast answer is used. 0 is no limit.
RAG_LLM_TIMEOUT_SECONDS=180
# Output token limit for concept extraction at ingestion. 480 cut qwen3:8b off mid-JSON.
RAG_CONCEPT_MAX_TOKENS=1024

# Episode 6 — Business guardrails. Read at start; a request cannot change them.
RAG_GUARDRAILS=off
RAG_GUARD_MAX_QUESTION_CHARS=2000
# off | block
RAG_GUARD_INJECTION=block
# Personal investment advice: off | block
RAG_GUARD_ADVICE=block
# Personal data in the question: off | redact | block
RAG_GUARD_PII_QUESTION=redact
# Personal data in the answer and returned chunks: off | redact
RAG_GUARD_PII_ANSWER=redact
# Retrieved chunks that give the assistant instructions: off | drop
RAG_GUARD_CONTEXT=drop
# Answers that repeat the system prompt: off | block
RAG_GUARD_PROMPT_LEAK=block
# A model check after the rules: off | llm. On a judge error: allow | block
RAG_GUARD_JUDGE=off
RAG_GUARD_JUDGE_ON_ERROR=allow
# Tokens per tenant per UTC day before answers fall back to the fast mode. 0 is no limit.
RAG_TENANT_DAILY_TOKEN_BUDGET=0

# Episode 7 — Cost reduction. See README for the measured trade-offs.
# Caches live in Redis; empty means process memory. The compose app uses redis://redis:6379/0.
REDIS_URL=
RAG_CACHE_PREFIX=beyondrag
# Embedding cache and batching: same vectors, fewer model calls. on | off
RAG_EMBEDDING_CACHE=on
# tenant: no cache hit across tenants (no timing signal). shared: more hits.
RAG_EMBEDDING_CACHE_SCOPE=tenant
RAG_EMBEDDING_BATCH=on
# Answer cache: off | exact | semantic. Scoped by tenant, roles and a corpus generation.
RAG_ANSWER_CACHE=off
RAG_ANSWER_CACHE_TTL=86400
RAG_SEMANTIC_CACHE_THRESHOLD=0.92
# Numbers, dates, names, negations and min/max words must match before a semantic hit.
RAG_SEMANTIC_CACHE_GUARD=on
# Cache temperature-0 model calls (rewrites, translation, judge, verifier). on | off
RAG_LLM_CACHE=off
# Model routing: off | static | cascade
RAG_ROUTING=off
RAG_MODEL_SMALL=qwen3:1.7b
# qwen3:4b on Ollama is a thinking build: it reasons into the answer even with thinking off.
RAG_MODEL_MEDIUM=qwen3:4b-instruct
# Empty: OLLAMA_MODEL
RAG_MODEL_LARGE=
RAG_CASCADE_FIRST=small
# Skip the model for single-fact questions when the re-ranker is confident. Needs RAG_RERANK=true.
RAG_ROUTE_EXTRACTIVE=off
RAG_EXTRACTIVE_MIN_SCORE=0.9
# Token optimization
RAG_COMPACT_SOURCES=off
# About this many context tokens, keeping the sentences closest to the question. 0 = all.
RAG_CONTEXT_BUDGET=0
RAG_ANSWER_MAX_TOKENS=0
# Ask the LLM verifier only about sentences the value check can't settle.
RAG_VERIFY_COMPACT=off
